module Tinkick
  class QueryText
    type misspellings = bool | { ?transpositions: bool, ?edit_distance: Integer, ?distance: Integer, ?prefix_length: Integer }

    @connection: ActiveRecord::ConnectionAdapters::AbstractAdapter

    def initialize: (ActiveRecord::ConnectionAdapters::AbstractAdapter connection) -> void

    def compile: (String term, ?operator: String, ?match: Symbol, ?misspellings: misspellings) -> String

    private

    def tokens: (String term) -> Array[String]

    def quote: (String term) -> String

    def literal: (String word) -> String

    def partial: (String word, Symbol match) -> String

    def fuzzy_partial: (String word, Symbol match, Integer distance, Integer prefix, bool transpositions) -> String

    def fuzzy: (String word, Integer distance, Integer prefix, bool transpositions) -> String

    def fuzzy_settings: (misspellings options) -> [ Integer, Integer, bool ]?
  end
end
