module Tinkick
  type association_spec = String | Symbol | Array[association_spec] | Hash[String | Symbol, association_spec?]

  type model_associations = Hash[singleton(ActiveRecord::Base), association_spec]

  type result_scope = ^(ActiveRecord::Relation) -> ActiveRecord::Relation

  type source_fields = String | Symbol | Array[String | Symbol]

  type source_selection = bool | source_fields | Hash[String | Symbol, source_fields]

  type result_record = ActiveRecord::Base | HashWrapper

  type missing_record = { id: String, model: singleton(ActiveRecord::Base) }

  type search_hit = { "_id" => String, "_index" => String, "_score" => Float, ?"_source" => Hash[String, result_value] }

  type response_hits = { "hits" => Array[search_hit], ?"total" => { "value" => Integer, "relation" => "eq" } }

  type response_aggregations = Hash[String, aggregation_result | Hash[String, Integer | aggregation_result]]

  type search_response = { "took" => Integer, "hits" => response_hits, ?"aggregations" => response_aggregations }

  class Results
    include Enumerable[result_record]
    extend Forwardable

    @query: Query
    @total_entries: Integer?
    @load: bool
    @includes: association_spec?
    @model_includes: model_associations?
    @scope_results: result_scope?
    @select: source_selection?
    @results: Array[result_record]?
    @record_pairs: Array[[ result_record, Float ]]?
    @missing_records: Array[missing_record]
    @source_rows: Array[Hash[String, result_value]]?
    @source_filter: SourceFilter?
    @hits: Array[search_hit]?
    @hit_pairs: Array[[ result_record, search_hit ]]
    @response: search_response?

    attr_reader current_page: Integer
    attr_reader padding: Integer

    def initialize: (Query query, ?page: Integer, ?padding: Integer, ?total_entries: Integer?, ?load: bool, ?includes: association_spec?, ?model_includes: model_associations?, ?scope_results: result_scope?, ?select: source_selection?) -> void

    def each: () -> Enumerator[result_record, Array[result_record]]
            | () { (result_record) -> void } -> Array[result_record]

    def any?: () -> bool
            | (Object pattern) -> bool
            | () { (result_record) -> boolish } -> bool

    def empty?: () -> bool
    def size: () -> Integer
    alias length size
    def []: (Integer index) -> result_record?
          | (Integer start, Integer length) -> Array[result_record]?
          | (Range[Integer?] range) -> Array[result_record]?
    alias slice []
    def to_ary: () -> Array[result_record]
    def aggs: () -> Hash[String, aggregation_result]?
    def aggregations: () -> response_aggregations?

    def model_name: () -> ActiveModel::Name
    def entry_name: (?Hash[Symbol, Object?] options) -> String
    def missing_records: () -> Array[missing_record]
    def misspellings?: () -> bool
    def took: () -> Integer
    def error: () -> nil
    def hits: () -> Array[search_hit]
    def with_hit: () -> Enumerator[[ result_record, search_hit ], Array[[ result_record, search_hit ]]]
                | () { (result_record, search_hit) -> void } -> Array[[ result_record, search_hit ]]
    def response: () -> search_response
    def total_count: () -> Integer
    alias total_entries total_count
    def per_page: () -> Integer
    alias limit_value per_page
    def total_pages: () -> Integer
    alias num_pages total_pages
    def offset_value: () -> Integer
    alias offset offset_value
    def previous_page: () -> Integer?
    alias prev_page previous_page
    def next_page: () -> Integer?
    def has_next_page?: () -> bool
    def next_cursor: () -> String?
    def first_page?: () -> bool
    def last_page?: () -> bool
    def out_of_range?: () -> bool
    def with_score: () -> Enumerator[[ result_record, Float ], Array[[ result_record, Float ]]]
                  | () { (result_record, Float) -> void } -> Array[[ result_record, Float ]]
    def pluck: (*String | Symbol keys) -> Array[result_value]

    private

    def load_page: () -> void

    def results: () -> Array[result_record]

    def preload_records: (Array[ActiveRecord::Base] records) -> Array[ActiveRecord::Base]
    def scoped_record_pairs: (result_scope scope) -> Array[[ ActiveRecord::Base, Float ]]

    def source_rows: () -> Array[Hash[String, result_value]]
    def read_source_rows: () -> Array[Hash[String, result_value]]
    def source_filter: () -> SourceFilter

    def record_pairs: () -> Array[[ result_record, Float ]]
  end
end
