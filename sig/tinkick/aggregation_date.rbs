module Tinkick
  type aggregation_zoned_time = Time | ActiveSupport::TimeWithZone

  class AggregationDate
    @format: String
    @offset: Integer
    @zone: ActiveSupport::TimeZone?

    def initialize: (?format: String?, ?time_zone: String | Integer | Float | nil) -> void
    def fixed_offset: () -> Integer?
    def parse: (aggregation_range_bound value) -> Float?
    def histogram_bound: (aggregation_range_bound value) -> Integer?
    def format: (Float value, ?utc_offset: Integer?) -> String

    private

    def local_time: (Time instant) -> aggregation_zoned_time
    def local_date: (Integer year, Integer month, Integer day, ?Integer hour, ?Integer minute, ?Integer | Rational second) -> aggregation_zoned_time
  end
end
