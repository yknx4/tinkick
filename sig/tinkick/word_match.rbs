module Tinkick
  class WordMatch
    ANALYSIS_DEFAULTS: Hash[String, String]

    @model: singleton(ActiveRecord::Base)

    def initialize: (singleton(ActiveRecord::Base) model) -> void
    def predicate: (String field_name, String term, misspellings: QueryText::misspellings, ?operator: String, ?match: Symbol) -> filter_predicate

    private

    def settings: (QueryText::misspellings options, Symbol match) -> [ Integer, bool ]
    def candidate: (String word, Integer prefix, Symbol match) -> String
    def partial_lengths: (String word, Integer prefix) -> [ Integer, Integer ]
    def refinement: (String column_sql, String options, String word, Integer prefix, Symbol match, String function) -> String
    def index_analysis: (String field_name, SearchField field) -> Hash[String, String]
  end
end
