module Tinkick
  class Highlighter
    @connection: ActiveRecord::ConnectionAdapters::AbstractAdapter

    def initialize: (ActiveRecord::ConnectionAdapters::AbstractAdapter connection) -> void
    def highlight: (String? text, String query, ?tag: String, ?encoder: String) -> String?
    def highlight_many: (Array[String?] texts, String query, ?tag: String, ?encoder: String) -> Array[String?]
    def whole_fields: (Array[String?] texts, ?tag: String, ?encoder: String, ?fragment_size: Integer, ?number_of_fragments: Integer) -> Array[Array[String]]
    def fragments_many: (Array[String?] texts, String query, ?tag: String, ?encoder: String, ?fragment_size: Integer, ?number_of_fragments: Integer) -> Array[Array[String]]

    private

    def validate_options: (String encoder, Integer fragment_size, Integer number_of_fragments) -> void

    def snippets: (String marked, String opening, String closing, Integer size, Integer maximum) -> Array[String]
    def fragment_parts: (String marked, String opening, String closing) -> [ Array[String], Array[[ Integer, Integer ]] ]
    def fragment_bounds: (Array[String] graphemes, Array[[ Integer, Integer ]] spans, Integer span_start, Integer span_end, Integer size) -> [ Integer, Integer ]
    def render_fragment: (Array[String] graphemes, Array[[ Integer, Integer ]] spans, Integer first, Integer last, String opening, String closing) -> String
    def mark_many: (Array[String?] texts, String query, String opening, String closing) -> Array[String?]
    def encode_html: (String text) -> String
  end
end
