module Tinkick
  type model_fields = search_fields

  type model_declaration = { ?searchable: model_fields?, ?default_fields: model_fields?, ?match: Symbol, ?stem: bool, ?highlight: Array[String | Symbol] | false | nil, ?filterable: Array[String | Symbol] | false | nil, ?word_start: Array[String | Symbol]?, ?word_middle: Array[String | Symbol]?, ?word_end: Array[String | Symbol]?, ?text_start: Array[String | Symbol]?, ?text_middle: Array[String | Symbol]?, ?text_end: Array[String | Symbol]? }

  type model_options = { filterable: Array[String | Symbol] | false | nil, highlight: Array[String | Symbol] | false | nil, searchable: model_fields?, default_fields: model_fields?, match: Symbol, word_start: Array[String | Symbol]?, word_middle: Array[String | Symbol]?, word_end: Array[String | Symbol]?, text_start: Array[String | Symbol]?, text_middle: Array[String | Symbol]?, text_end: Array[String | Symbol]? }

  type index_configuration = { column_name: String?, expression: String?, analysis: Hash[String, String] }

  type model_schema = { columns: Hash[String, ActiveRecord::ConnectionAdapters::Column], pool: ActiveRecord::ConnectionAdapters::ConnectionPool, data_fields: Array[String], index_fields: Array[String], index_expressions: Array[String], index_configurations: Array[index_configuration], analysis: Hash[String, Hash[String, String]] }

  module Model
    @tinkick_options: model_options?

    @tinkick_schema: model_schema?

    def tinkick: (?searchable: model_fields?, ?default_fields: model_fields?, ?match: Symbol, ?stem: bool, ?highlight: Array[String | Symbol] | false | nil, ?filterable: Array[String | Symbol] | false | nil, ?word_start: Array[String | Symbol]?, ?word_middle: Array[String | Symbol]?, ?word_end: Array[String | Symbol]?, ?text_start: Array[String | Symbol]?, ?text_middle: Array[String | Symbol]?, ?text_end: Array[String | Symbol]?, **Object? options) -> void

    def tinkick_options: () -> model_options?

    def tinkick_search: (?Object? term, ?fields: model_fields?, ?misspellings: QueryText::misspellings, ?where: filter_conditions, ?order: query_order?, ?limit: relation_number, ?offset: relation_number, ?page: relation_number, ?per_page: relation_number, ?padding: relation_number, ?match: Symbol?, ?operator: String | Symbol, ?load: bool?, ?total_entries: Integer?, ?countless: bool, ?keyset: bool, ?after: String?, ?aggs: aggregation_spec?, ?smart_aggs: bool, ?includes: association_spec?, ?model_includes: model_associations?, ?scope_results: result_scope?, ?exclude: exclusion_phrases, ?select: source_selection?, ?highlight: highlight_options, ?boost_by: numeric_boost_spec) -> Relation

    def tinkick_expand_fields: (model_fields fields, match: Symbol) -> model_fields

    def tinkick_index_analysis: (String field_name, SearchField field) -> Hash[String, String]

    alias search tinkick_search

    private

    def tinkick_validate_filterable: (model_schema schema, Array[String | Symbol] fields) -> void

    def tinkick_default_fields: (model_schema schema) -> Array[String]

    def tinkick_wildcard_candidates: (model_schema schema, Symbol mode) -> Array[String]

    def tinkick_schema: () -> model_schema

    def tinkick_data_fields: (Hash[String, ActiveRecord::ConnectionAdapters::Column] columns) -> Array[String]

    def tinkick_validate_fields: (model_schema schema, model_fields fields, Symbol match) -> void
  end
end

module ActiveRecord
  class Base
    extend Tinkick::Model
  end
end
