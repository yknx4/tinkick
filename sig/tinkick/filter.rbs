module Tinkick
  type filter_scalar = String | Symbol | Numeric | Date | Time | bool | nil

  type filter_value = Regexp | filter_scalar | Array[filter_value] | Range[filter_scalar] | Hash[String | Symbol, filter_value]

  type filter_conditions = Hash[String | Symbol, filter_value]

  type filter_predicate = [ String, Array[filter_scalar] ]

  class Filter
    @model: singleton(ActiveRecord::Base)

    def initialize: (singleton(ActiveRecord::Base) model) -> void

    def apply: (ActiveRecord::Relation scope, filter_conditions conditions) -> ActiveRecord::Relation
    def predicate: (filter_conditions conditions) -> filter_predicate

    private

    def predicates: (filter_value conditions) -> Array[filter_predicate]

    def column_reference: (String | Symbol field) -> [ String, String?, Array[String]?, Hash[String, filter_scalar]? ]

    def json_predicates: (String column, Array[String] path, filter_value value) -> Array[filter_predicate]

    def json_equality: (String column, Array[String] path, filter_value value) -> filter_predicate

    def json_match: (String column, Array[String] path, String condition, ?descendants: bool) -> filter_predicate

    def json_text_predicate: (String column, Array[String] path, :like | :ilike | :prefix | :regexp operator, filter_value value) -> filter_predicate

    def json_values: (String column, Array[String] path, ?descendants: bool) -> filter_predicate

    def warn_json_scan: (String column) -> void

    def field_predicates: (String column, filter_value value, ?array_type: String?, ?enum_values: Hash[String, filter_scalar]?) -> Array[filter_predicate]

    def equality: (String column, filter_value value, ?array_type: String?, ?enum_values: Hash[String, filter_scalar]?) -> filter_predicate

    def existence: (String column, filter_value value, ?array_type: String?) -> filter_predicate

    def element_predicate: (String column, filter_predicate predicate, String? array_type) -> filter_predicate

    def text_predicate: (String column, :like | :ilike | :prefix | :regexp operator, filter_value value) -> filter_predicate

    def comparison: (String column, :gt | :gte | :lt | :lte operator, filter_value value) -> filter_predicate

    def range_predicate: (String column, Range[filter_scalar] range) -> filter_predicate

    def scalar: (filter_value value) -> filter_scalar

    def negate: (filter_predicate predicate) -> filter_predicate

    def combine: (Array[filter_predicate] predicates, "AND" | "OR" operator) -> filter_predicate
  end
end
