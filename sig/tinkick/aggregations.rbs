module Tinkick
  type aggregation_order = Hash[String | Symbol, String | Symbol] | Array[Hash[String | Symbol, String | Symbol]]

  type aggregation_metric_name = :avg | :cardinality | :max | :min | :sum

  type aggregation_metric_options = { ?field: String | Symbol }

  type aggregation_range_options = { ?from: Numeric | String | nil, ?to: Numeric | String | nil, ?key: String }

  type aggregation_options = { ?field: String | Symbol, ?limit: Integer, ?order: aggregation_order, ?min_doc_count: Integer, ?where: filter_conditions, ?ranges: Array[aggregation_range_options], ?keyed: bool, ?avg: aggregation_metric_options, ?cardinality: aggregation_metric_options, ?max: aggregation_metric_options, ?min: aggregation_metric_options, ?sum: aggregation_metric_options }

  type aggregation_spec = Array[String | Symbol] | Hash[String | Symbol, aggregation_options]

  type aggregation_bucket = { "key" => String | Numeric, "doc_count" => Integer, ?"key_as_string" => String }

  type aggregation_terms = { "doc_count_error_upper_bound" => Integer, "sum_other_doc_count" => Integer, "buckets" => Array[aggregation_bucket], ?"doc_count" => Integer }

  type aggregation_metric = { "value" => Numeric?, ?"doc_count" => Integer }

  type aggregation_range_bucket = { "key" => String, "doc_count" => Integer, ?"from" => Float, ?"to" => Float }

  type aggregation_keyed_range_bucket = { "doc_count" => Integer, ?"from" => Float, ?"to" => Float }

  type aggregation_ranges = { "buckets" => Array[aggregation_range_bucket] | Hash[String, aggregation_keyed_range_bucket], ?"doc_count" => Integer }

  type aggregation_result = aggregation_terms | aggregation_metric | aggregation_ranges

  class Aggregations
    @model: singleton(ActiveRecord::Base)
    @scope: ActiveRecord::Relation
    @dictionary_scope: ActiveRecord::Relation

    def initialize: (singleton(ActiveRecord::Base) model, ActiveRecord::Relation scope, ?dictionary_scope: ActiveRecord::Relation) -> void

    def call: (aggregation_spec spec) -> Hash[String, aggregation_result]

    private

    def terms: (String field, aggregation_options options) -> aggregation_terms

    def calculate_metric: (aggregation_metric_name metric, String field, filter_conditions? conditions) -> aggregation_metric

    def numeric_ranges: (String field, Array[aggregation_range_options] ranges, aggregation_options options) -> aggregation_ranges

    def numeric_bound: (Numeric | String | nil value) -> Float?

    def values_relation: (ActiveRecord::Relation scope, String field, ?unique: bool) -> ActiveRecord::Relation

    def order_sql: (aggregation_order order) -> String

    def bucket: (result_value value, Integer count) -> aggregation_bucket
  end
end
