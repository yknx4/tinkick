module Tinkick
  type aggregation_order = Hash[String | Symbol, String | Symbol] | Array[Hash[String | Symbol, String | Symbol]]

  type aggregation_metric_name = :avg | :cardinality | :max | :min | :sum

  type aggregation_metric_options = { ?field: String | Symbol, ?missing: filter_scalar }

  type aggregation_range_bound = Numeric | String | Date | Time | nil

  type aggregation_range_options = { ?from: aggregation_range_bound, ?to: aggregation_range_bound, ?key: String }

  type aggregation_histogram_bounds = { ?min: Numeric?, ?max: Numeric? }

  type aggregation_date_histogram_bounds = { ?min: aggregation_range_bound, ?max: aggregation_range_bound }

  type aggregation_histogram_options = { ?field: String | Symbol, interval: Numeric, ?offset: Numeric, ?missing: filter_scalar, ?min_doc_count: Integer, ?order: aggregation_order, ?keyed: bool, ?extended_bounds: aggregation_histogram_bounds, ?hard_bounds: aggregation_histogram_bounds }

  type aggregation_date_histogram_options = { ?field: String | Symbol, ?calendar_interval: String | Symbol, ?fixed_interval: String | Symbol, ?min_doc_count: Integer, ?order: aggregation_order, ?keyed: bool, ?time_zone: String | Integer | Float, ?format: String, ?offset: String | Integer | Float, ?extended_bounds: aggregation_date_histogram_bounds, ?hard_bounds: aggregation_date_histogram_bounds }

  type aggregation_term_filter = String | Array[filter_scalar] | Regexp | Hash[String | Symbol, Integer]

  type aggregation_options = { ?field: String | Symbol, ?missing: filter_scalar, ?limit: Integer, ?include: aggregation_term_filter, ?exclude: aggregation_term_filter, ?order: aggregation_order, ?min_doc_count: Integer, ?where: filter_conditions, ?ranges: Array[aggregation_range_options], ?date_ranges: Array[aggregation_range_options], ?histogram: aggregation_histogram_options, ?date_histogram: aggregation_date_histogram_options, ?keyed: bool, ?time_zone: String | Integer | Float, ?format: String, ?avg: aggregation_metric_options, ?cardinality: aggregation_metric_options, ?max: aggregation_metric_options, ?min: aggregation_metric_options, ?sum: aggregation_metric_options }

  type aggregation_spec = Array[String | Symbol] | Hash[String | Symbol, aggregation_options]

  type aggregation_bucket = { "key" => String | Numeric, "doc_count" => Integer, ?"key_as_string" => String }

  type aggregation_terms = { "doc_count_error_upper_bound" => Integer, "sum_other_doc_count" => Integer, "buckets" => Array[aggregation_bucket], ?"doc_count" => Integer }

  type aggregation_metric = { "value" => Numeric?, ?"doc_count" => Integer }

  type aggregation_range_bucket = { "key" => String, "doc_count" => Integer, ?"from" => Float, ?"to" => Float, ?"from_as_string" => String, ?"to_as_string" => String }

  type aggregation_keyed_range_bucket = { "doc_count" => Integer, ?"from" => Float, ?"to" => Float, ?"from_as_string" => String, ?"to_as_string" => String }

  type aggregation_ranges = { "buckets" => Array[aggregation_range_bucket] | Hash[String, aggregation_keyed_range_bucket], ?"doc_count" => Integer }

  type aggregation_histogram_bucket = { "key" => Float, "doc_count" => Integer }

  type aggregation_histogram = { "buckets" => Array[aggregation_histogram_bucket] | Hash[String, aggregation_histogram_bucket], ?"doc_count" => Integer }

  type aggregation_date_histogram_bucket = { "key" => Integer, "key_as_string" => String, "doc_count" => Integer }

  type aggregation_date_histogram = { "buckets" => Array[aggregation_date_histogram_bucket] | Hash[String, aggregation_date_histogram_bucket], ?"doc_count" => Integer }

  type aggregation_result = aggregation_terms | aggregation_metric | aggregation_ranges | aggregation_histogram | aggregation_date_histogram

  class Aggregations
    @model: singleton(ActiveRecord::Base)
    @unscoped: ActiveRecord::Relation
    @scope: ActiveRecord::Relation
    @dictionary_scope: ActiveRecord::Relation

    def initialize: (singleton(ActiveRecord::Base) model, ActiveRecord::Relation scope, ?dictionary_scope: ActiveRecord::Relation) -> void

    def call: (aggregation_spec spec) -> Hash[String, aggregation_result]

    private

    def date_histogram: (String field, aggregation_date_histogram_options options, filter_conditions? conditions) -> aggregation_date_histogram

    def zoned_date_histogram: (String field, aggregation_date_histogram_options options, filter_conditions? conditions, AggregationDate formatter, String? unit, String step, Integer bucket_offset, Integer minimum) -> aggregation_date_histogram

    def zoned_rounding_sql: (String value, unit: String?) -> String

    def zoned_histogram_bounds: (aggregation_date_histogram_options options, AggregationDate formatter, Hash[Symbol, String] binds, unit: String?) -> [ Time?, Time?, Time?, Time? ]

    def date_histogram_offset: (String | Integer | Float value) -> Integer

    def fixed_interval_milliseconds: (String | Symbol value, ?allow_zero: bool) -> Integer

    def numeric_histogram: (String field, aggregation_histogram_options options, filter_conditions? conditions) -> aggregation_histogram

    def histogram_bounds: (aggregation_histogram_bounds bounds) -> [ Float?, Float? ]

    def terms: (String field, aggregation_options options) -> aggregation_terms

    def term_filter: (ActiveRecord::Relation query, aggregation_term_filter value, exclude: bool) -> ActiveRecord::Relation

    def calculate_metric: (aggregation_metric_name metric, String field, filter_conditions? conditions, ?missing: filter_scalar) -> aggregation_metric

    def range_aggregation: (String field, Array[aggregation_range_options] ranges, aggregation_options options, ?dates: bool) -> aggregation_ranges

    def numeric_bound: (aggregation_range_bound value) -> Float?

    def values_relation: (ActiveRecord::Relation scope, String field, ?unique: bool, ?missing: filter_scalar) -> ActiveRecord::Relation

    def order_sql: (aggregation_order order) -> String

    def bucket: (result_value value, Integer count) -> aggregation_bucket
  end
end
