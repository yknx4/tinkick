module Tinkick
  type search_field = String | Symbol | Hash[String | Symbol, Symbol]

  type search_fields = Array[search_field]

  type exclusion_scalar = String | Integer | Float | bool

  type exclusion_phrases = exclusion_scalar | Array[exclusion_scalar] | nil

  type query_order = String | Symbol | Hash[String | Symbol, String | Symbol] | Array[query_order]

  type conversion_term = String | Symbol | Integer | Float | bool | nil

  type conversion_options = { ?field: String | Symbol | true | nil, ?term: conversion_term, ?factor: conversion_factor | false | nil }

  type conversion_v2 = bool | String | Symbol | conversion_options | nil

  class Query
    @model: singleton(ActiveRecord::Base)
    @query_block: result_scope?
    @base_scope: ActiveRecord::Relation
    @term: String
    @fields: Array[[ String, Symbol, Float? ]]
    @weighted_scoring: bool
    @boost_by: BoostBy
    @conversions: Array[ConversionScores]
    @where: filter_conditions
    @aggregation_spec: aggregation_spec?
    @smart_aggs: bool
    @aggs: Hash[String, aggregation_result]?
    @order: query_order?
    @limit: Integer
    @offset: Integer
    @operator: String
    @match: Symbol
    @misspellings: QueryText::misspellings
    @misspelling_fields: Array[String]?
    @misspellings_below: Integer?
    @exclude: Array[String]
    @records: Array[ActiveRecord::Base]?
    @rows: Array[Hash[String, result_value]]?
    @source_cursor_row: Hash[String, result_value]?
    @total_count: Integer?
    @took: Integer?
    @scope: ActiveRecord::Relation?
    @scoring: String
    @mixed_matching: bool
    @countless: bool
    @keyset: bool
    @has_next_page: bool?
    @keyset_order: Keyset?

    attr_reader model: singleton(ActiveRecord::Base)
    attr_reader limit: Integer
    attr_reader after: String?
    attr_reader took: Integer?

    def initialize: (singleton(ActiveRecord::Base) model, Object? term, fields: search_fields, ?base_scope: ActiveRecord::Relation, ?where: filter_conditions, ?order: query_order?, ?limit: Integer | String, ?offset: Integer | String | nil, ?operator: String | Symbol, ?match: Symbol, ?misspellings: QueryText::misspellings, ?countless: bool, ?keyset: bool, ?after: String?, ?aggs: aggregation_spec?, ?smart_aggs: bool, ?exclude: exclusion_phrases, ?boost_by: numeric_boost_spec, ?boost_where: where_boosts, ?boost: legacy_boost, ?boost_by_recency: recency_boost_spec, ?conversions: conversion_fields, ?conversions_v2: conversion_v2, ?conversions_term: conversion_term, ?block: result_scope?) -> void

    def to_relation: () -> ActiveRecord::Relation

    def records: () -> Array[ActiveRecord::Base]

    def rows: () -> Array[Hash[String, result_value]]

    def source_rows: (Array[String] columns) -> Array[Hash[String, result_value]]

    def pluck_rows: (Array[String | Symbol] columns) -> Array[Hash[String, result_value]]

    def aggs: () -> Hash[String, aggregation_result]?

    def highlight_fields: () -> Array[String]
    def highlight_matches: (String name, texts: Array[String?]) -> Array[String?]
    def highlight_query: (String name) -> String

    def total_count: () -> Integer
    def misspellings?: () -> bool
    def countless?: () -> bool
    def keyset?: () -> bool
    def has_next_page?: () -> bool
    def next_cursor: () -> String?

    private

    def normalize_conversions: (conversion_fields legacy, conversion_v2 modern, conversion_term term) -> Array[ConversionScores]

    def measure_page: [T] () { () -> T } -> T
    def instrument: [T] (:search | :count | :aggregations operation) { () -> T } -> T

    def normalize_misspellings: (QueryText::misspellings options, search_fields fields) -> QueryText::misspellings
    def resolve_misspellings: () -> void
    def misspellings_for: (String name) -> QueryText::misspellings

    def normalize_exclusions: (exclusion_phrases value) -> Array[String]

    def read_rows: (ActiveRecord::Relation relation) -> Array[Hash[String, result_value]]

    def trim_page: [T] (Array[T] values) -> Array[T]
    def keyset_order: () -> Keyset

    def scope: () -> ActiveRecord::Relation
    def build_scope: (filter_conditions conditions) -> ActiveRecord::Relation
    def excluding_scope: (ActiveRecord::Relation relation, Array[[ String, SearchField, Symbol, Float? ]] fields, QueryText compiler) -> [ ActiveRecord::Relation, String? ]
    def field_predicate: (SearchField field, filter_predicate predicate) -> filter_predicate
    def matching_scope: (ActiveRecord::Relation relation, Array[filter_predicate] predicates) -> ActiveRecord::Relation
    def mixed_scope: (ActiveRecord::Relation relation, Array[filter_predicate] native, Array[filter_predicate] exact) -> ActiveRecord::Relation
    def scored_scope: (ActiveRecord::Relation relation, Array[[ Array[filter_predicate], String ]] scores) -> ActiveRecord::Relation

    def ranked_scope: (ActiveRecord::Relation relation) -> ActiveRecord::Relation
    def customized_scope: (ActiveRecord::Relation relation) -> ActiveRecord::Relation
    def count_scope: (ActiveRecord::Relation relation) -> ActiveRecord::Relation
    def projected_scope: (Array[Arel::Nodes::SqlLiteral | Arel::Nodes::BoundSqlLiteral] projection) -> ActiveRecord::Relation

    def record_scope: () -> ActiveRecord::Relation

    def order_clauses: (query_order value, ?array: bool) -> Array[String]

    def order_expression: (String field) -> String

    def score_sql: () -> String

    def validate_column: (String field) -> void

    def quoted_column: (String field) -> String

    def quoted_table: () -> String
  end
end
