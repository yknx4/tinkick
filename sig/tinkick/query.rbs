module Tinkick
  type search_field = String | Symbol | Hash[String | Symbol, Symbol]

  type search_fields = Array[search_field]

  type query_order = String | Symbol | Hash[String | Symbol, String | Symbol] | Array[query_order]

  class Query
    @model: singleton(ActiveRecord::Base)
    @term: String
    @fields: Array[[ String, Symbol ]]
    @where: filter_conditions
    @aggregation_spec: aggregation_spec?
    @smart_aggs: bool
    @aggs: Hash[String, aggregation_result]?
    @order: query_order?
    @limit: Integer
    @offset: Integer
    @operator: String
    @match: Symbol
    @misspellings: QueryText::misspellings
    @records: Array[ActiveRecord::Base]?
    @rows: Array[Hash[String, result_value]]?
    @total_count: Integer?
    @scope: ActiveRecord::Relation?
    @scoring: String
    @mixed_matching: bool
    @fuzzy_partial: bool
    @countless: bool
    @keyset: bool
    @has_next_page: bool?
    @keyset_order: Keyset?

    attr_reader model: singleton(ActiveRecord::Base)
    attr_reader limit: Integer
    attr_reader after: String?

    def initialize: (singleton(ActiveRecord::Base) model, Object? term, fields: search_fields, ?where: filter_conditions, ?order: query_order?, ?limit: Integer | String, ?offset: Integer | String | nil, ?operator: String | Symbol, ?match: Symbol, ?misspellings: QueryText::misspellings, ?countless: bool, ?keyset: bool, ?after: String?, ?aggs: aggregation_spec?, ?smart_aggs: bool) -> void

    def records: () -> Array[ActiveRecord::Base]

    def rows: () -> Array[Hash[String, result_value]]

    def pluck_rows: (Array[String | Symbol] columns) -> Array[Hash[String, result_value]]

    def aggs: () -> Hash[String, aggregation_result]?

    def total_count: () -> Integer
    def countless?: () -> bool
    def keyset?: () -> bool
    def has_next_page?: () -> bool
    def next_cursor: () -> String?

    private

    def trim_page: [T] (Array[T] values) -> Array[T]
    def keyset_order: () -> Keyset

    def scope: () -> ActiveRecord::Relation
    def build_scope: (filter_conditions conditions) -> ActiveRecord::Relation
    def field_predicate: (SearchField field, filter_predicate predicate) -> filter_predicate
    def matching_scope: (ActiveRecord::Relation relation, Array[filter_predicate] predicates) -> ActiveRecord::Relation
    def mixed_scope: (ActiveRecord::Relation relation, Array[filter_predicate] native, Array[filter_predicate] exact) -> ActiveRecord::Relation

    def record_scope: () -> ActiveRecord::Relation

    def order_clauses: (query_order value) -> Array[String]

    def score_sql: () -> String

    def validate_column: (String field) -> void

    def quoted_column: (String field) -> String

    def quoted_table: () -> String
  end
end
