module Tinkick
  VERSION: String

  self.@search_method_name: String | Symbol | nil

  def self.search_method_name: () -> (String | Symbol | nil)

  def self.search_method_name=: (String | Symbol | nil) -> (String | Symbol | nil)

  self.@model_options: model_declaration

